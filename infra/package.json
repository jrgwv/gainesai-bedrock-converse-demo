{
  "name": "bedrock-converse-infra",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc",
    "lint": "eslint .",
    "format:check": "prettier --check '**/*.ts'",
    "test": "jest --coverage",
    "cdk:synth": "cdk synth",
    "cdk:diff": "cdk diff",
    "cdk:deploy:dev": "cdk deploy --context env=dev",
    "cdk:deploy:prod": "cdk deploy --context env=prod --require-approval broadening",
    "audit": "npm audit --audit-level=high"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "22",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "aws-cdk": ">=2.180.0",
    "eslint": "^9.0.0",
    "jest": "^29.7.0",
    "prettier": "^3.0.0",
    "source-map-support": "^0.5.21",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.1",
    "typescript": "~5.5.0"
  },
  "dependencies": {
    "aws-cdk-lib": ">=2.180.0",
    "cdk-nag": "^2.28.0",
    "constructs": "^10.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "roots": ["<rootDir>/test"],
    "testMatch": ["**/*.test.ts"],
    "transform": {
      "^.+\\.tsx?$": "ts-jest"
    }
  }
}
